# 이 파일을 .env.local 로 복사한 뒤 값을 채워 사용한다.
#   cp .env.example .env.local
# .env.local 은 git에 올라가지 않으며, .env 보다 우선 적용된다.

# 백엔드 API 서버 주소. 코드가 여기에 /api 를 붙여 호출한다.
# (apis/api-client.ts, app/api/auth/_lib.ts)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 이 서비스 자체의 공개 주소. 백엔드 주소와는 별개다.
# canonical·og:url·sitemap이 절대 URL이어야 해서 필요하다. (constants/site.ts)
# 프로덕션 빌드에서는 필수이며, 없거나 형식이 틀리면 빌드가 실패한다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
